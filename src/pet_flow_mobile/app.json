{
  "expo": {
    "name": "PetFlow",
    "slug": "pet-flow-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-petflow.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo-petflow.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-petflow.png",
        "backgroundColor": "#197BE9"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-font"
    ]
  }
}
